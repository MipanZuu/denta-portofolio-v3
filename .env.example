# Canonical production origin, without a trailing slash
SITE_URL=

# Neon database (the Vercel/Neon integration may provide DB_DATABASE_URL instead)
DB_DATABASE_URL=

# Neon Auth (Vercel's current Neon integration may provide NEON_AUTH_BASE_URL;
# some integration setups expose DB_NEON_AUTH_BASE_URL instead)
NEON_AUTH_BASE_URL=
DB_NEON_AUTH_BASE_URL=
# Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Dashboard authorization. Prefer the immutable Neon Auth user ID in production.
# Comma-separated values are supported. If IDs are set, email is not used for
# dashboard authorization.
PORTFOLIO_ADMIN_USER_IDS=
PORTFOLIO_ADMIN_EMAILS=

# Enable only for the initial owner account setup, then remove/disable it.
AUTH_ALLOW_ADMIN_SIGN_UP=false

# Vercel Blob image uploads
BLOB_READ_WRITE_TOKEN=

# Spotify "Current mood" card (server-only)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/spotify/callback
